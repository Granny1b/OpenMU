# Website configuration. Copy to .env next to the compose file and fill in.
# Everything here is read as MUSITE_* environment variables by src/MuSite/Program.cs.

# --- database passwords (generate six distinct ones, e.g. `openssl rand -base64 24`) -----------
MUSITE_DB_READ_PW=
MUSITE_DB_AUTH_PW=
MUSITE_DB_REG_PW=
MUSITE_DB_APP_PW=
MUSITE_DB_OWN_PW=
# The log shipper. Append-only on server_log and nothing else, so this is the least dangerous of
# the six - it cannot read back a single line it wrote.
MUSITE_DB_LOG_PW=

# --- who administers the website ---------------------------------------------------------------
# GAME account login names, one per slot. The compose file maps these onto MUSITE_ADMINS__0 and __1.
# An account also needs State = GameMaster (2) or GameMasterInvisible (3), set in the OpenMU admin
# panel. BOTH conditions are required.
# EMPTY MEANS ZERO ADMINS - /admin returns 404 for everyone. This is deliberate; do not "simplify" it.
# Case-sensitive, because data."Account"."LoginName" is.
MUSITE_ADMIN_1=
MUSITE_ADMIN_2=
# The one login name that additionally gets Owner (password reset). Must also be one of the above.
MUSITE_OWNER=

# --- game client ---------------------------------------------------------------------------------
# 20 for Season 6, 10 for 0.75/0.95d clients. A password longer than the client's field is truncated
# by the client, so BCrypt.Verify then fails forever with no diagnostic. Lowering this later strands
# every account registered in between. Set it once, correctly.
MUSITE_MAXPASSWORD=20

# --- presentation ---------------------------------------------------------------------------------
MUSITE_SERVERNAME=My MU Server
MUSITE_CLIENTURL=
MUSITE_CONNECTHOST=play.example.org:44405
MUSITE_DISCORDURL=

# --- status probe -----------------------------------------------------------------------------------
# Set by the compose file to the connect server's CONTAINER name and internal port
# (openmu-startup:44405), which is the same on every deploy variant. Probing a published host port
# instead would report "offline" forever on a variant that publishes a different one.

# --- reverse proxy -------------------------------------------------------------------------------
# CIDR of the proxy, so X-Forwarded-For is honoured and rate limits are per visitor rather than one
# global bucket. The docker bridge network for the all-in-one nginx setup is usually 172.16.0.0/12.
MUSITE_TRUSTEDNETWORKS=172.16.0.0/12

# --- abuse control -------------------------------------------------------------------------------
# Registrations per day before the site closes registration by itself and writes an audit row.
MUSITE_REGISTRATIONDAILYCAP=200

# This file documents every variable. Copy the ones you need into the .env file that sits next to
# deploy/all-in-one/docker-compose.yml - that is the file docker compose reads.
