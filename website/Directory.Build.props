<Project>
  <!-- Deliberately standalone: this file exists so /website never inherits src/Directory.Build.props
       (StyleCop, SharedAssemblyInfo, analyzer rules). The website is not part of the OpenMU solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
