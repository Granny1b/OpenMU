@page "/guilds"
@model GuildsModel
@{
    ViewData["Title"] = "Guilds";
}

<h1>Guilds</h1>

<div class="mu-panel">
    <div class="mu-panel__head">
        <h2 class="mu-panel__title">By score</h2>
        <span class="mu-panel__aside">updated @Model.Age</span>
    </div>
    <div class="mu-panel__body">
        <form method="get" class="mu-field mu-field--md">
            <label class="mu-label" for="q">Find a guild</label>
            <input class="mu-input" id="q" name="q" type="search" value="@Model.Search" placeholder="name" />
        </form>

        @if (Model.Rows.Count == 0)
        {
            <div class="mu-empty">
                <div class="mu-empty__title">No guilds yet</div>
                A guild appears here once it has been founded in the game.
            </div>
        }
        else
        {
            <div class="mu-tablewrap">
                <table class="mu-table">
                    <thead><tr><th>#</th><th>Guild</th><th class="mu-table__num">Score</th><th class="mu-table__num">Members</th></tr></thead>
                    <tbody>
                    @{ var rank = Model.Offset; }
                    @foreach (var row in Model.Rows)
                    {
                        rank++;
                        <tr>
                            <td class="mu-rank @(rank <= 3 ? $"mu-rank--{rank}" : null)">@rank</td>
                            <td><a href="/guild/@Uri.EscapeDataString(row.Name)">@row.Name</a></td>
                            <td class="mu-table__num">@row.Score.ToString("N0")</td>
                            <td class="mu-table__num">@row.Members</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="mu-pager">
                @if (Model.PageNumber > 1)
                {
                    <a class="mu-btn mu-btn--sm" href="@Model.PageLink(Model.PageNumber - 1)">&lsaquo; Previous</a>
                }
                <span class="mu-muted">Page @Model.PageNumber</span>
                @if (Model.HasMore)
                {
                    <a class="mu-btn mu-btn--sm" href="@Model.PageLink(Model.PageNumber + 1)">Next &rsaquo;</a>
                }
            </div>
        }
    </div>
</div>
