@page
@model IndexModel
@using MuSite.Data
@{
    ViewData["Title"] = null;
}

<div class="mu-hero">
    <h1>@Model.ServerName</h1>
    <p>A private MU Online server running on OpenMU.</p>
    <a class="mu-btn mu-btn--primary" href="/register">Create an account</a>
    <a class="mu-btn" href="/downloads">How to connect</a>
</div>

<div class="mu-status">
    <div class="mu-status__cell">
        <span class="mu-status__label">Server</span>
        <span class="mu-status__value">@(Model.IsUp ? "Online" : "Offline")</span>
    </div>
    <div class="mu-status__cell">
        <span class="mu-status__label">Accounts</span>
        <span class="mu-status__value">@Model.Accounts.ToString("N0")</span>
    </div>
    <div class="mu-status__cell">
        <span class="mu-status__label">Characters</span>
        <span class="mu-status__value">@Model.Characters.ToString("N0")</span>
    </div>
    <div class="mu-status__cell">
        <span class="mu-status__label">Version</span>
        <span class="mu-status__value">Season 6</span>
    </div>
</div>

@if (!Model.SchemaHealthy)
{
    <div class="mu-notice mu-notice--danger">
        Some pages are temporarily unavailable while the server is being maintained.
    </div>
}

<div class="mu-grid2">
    <div class="mu-panel">
        <div class="mu-panel__head">
            <h2 class="mu-panel__title">@(Model.News.Count > 0 ? "Announcements" : "Getting started")</h2>
            @if (Model.News.Count > 0)
            {
                <span class="mu-panel__aside"><a href="/news">All</a></span>
            }
        </div>
        <div class="mu-panel__body">
            @if (Model.News.Count > 0)
            {
                foreach (var post in Model.News)
                {
                    <h3 style="margin-bottom:2px"><a href="/news/@post.Slug">@post.Title</a></h3>
                    <p class="mu-muted" style="margin:0 0 12px;font-size:.85rem">
                        @post.PublishedAt?.ToString("yyyy-MM-dd")
                    </p>
                }
            }
            else
            {
                <ol style="margin:0;padding-left:1.2em">
                    <li>Create an account here.</li>
                    <li>Download the client and point the launcher at <span class="mu-mono">@Model.ConnectHost</span>.</li>
                    <li>Make a character and pick a server from the list.</li>
                </ol>
            }
        </div>
    </div>

    <div class="mu-panel">
        <div class="mu-panel__head">
            <h2 class="mu-panel__title">Top players</h2>
            <span class="mu-panel__aside">updated @Model.Age</span>
        </div>
        <div class="mu-panel__body">
            @if (Model.Top.Count == 0)
            {
                <div class="mu-empty">
                    <div class="mu-empty__title">No characters yet</div>
                    Be the first &mdash; the board fills up as people play.
                </div>
            }
            else
            {
                <div class="mu-tablewrap">
                    <table class="mu-table">
                        <thead><tr><th>#</th><th>Character</th><th>Class</th><th class="mu-table__num">Level</th></tr></thead>
                        <tbody>
                        @{ var rank = 0; }
                        @foreach (var row in Model.Top)
                        {
                            rank++;
                            <tr>
                                <td class="mu-rank @(rank <= 3 ? $"mu-rank--{rank}" : null)">@rank</td>
                                <td><a href="/character/@Uri.EscapeDataString(row.Name)">@row.Name</a></td>
                                <td>@(row.Class ?? "—")</td>
                                <td class="mu-table__num">@row.Level</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <p class="mu-hint" style="margin-bottom:0"><a href="/rankings/level">See the full rankings</a></p>
            }
        </div>
    </div>
</div>
