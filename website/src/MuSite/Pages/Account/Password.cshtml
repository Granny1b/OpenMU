@page "/account/password"
@model MuSite.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "Change password";
}

<h1>Change password</h1>

<div class="mu-panel mu-form-narrow">
    <div class="mu-panel__body">
        @if (Model.Error is { } error)
        {
            <div class="mu-notice mu-notice--danger">@error</div>
        }

        <form method="post">
            <div class="mu-field">
                <label class="mu-label" for="Input_Current">Current password</label>
                <input class="mu-input" id="Input_Current" name="Input.Current" type="password"
                       autocomplete="current-password" required autofocus />
            </div>

            <div class="mu-field">
                <label class="mu-label" for="Input_New">New password</label>
                <input class="mu-input" id="Input_New" name="Input.New" type="password"
                       autocomplete="new-password" required />
                <p class="mu-hint">Between @Model.MinPassword and @Model.MaxPassword characters. This is the
                   password you use in the game as well.</p>
            </div>

            <div class="mu-field">
                <label class="mu-label" for="Input_Confirm">Repeat new password</label>
                <input class="mu-input" id="Input_Confirm" name="Input.Confirm" type="password"
                       autocomplete="new-password" required />
            </div>

            <div class="mu-notice mu-notice--warn">
                Every other browser signed in to this account will be signed out.
            </div>

            <button class="mu-btn mu-btn--primary" type="submit">Change password</button>
            <a class="mu-btn" href="/account">Cancel</a>
        </form>
    </div>
</div>
