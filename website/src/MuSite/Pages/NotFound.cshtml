@page "/not-found"
@{
    ViewData["Title"] = "Not found";
}

<div class="mu-panel">
    <div class="mu-panel__head"><h2 class="mu-panel__title">Not found</h2></div>
    <div class="mu-panel__body">
        <p>There is no page, character or guild at that address.</p>
        <p class="mu-hint">Character and guild names are looked up as they are spelled in the game,
           though capitalisation does not matter.</p>
        <a class="mu-btn" href="/rankings/level">Browse the rankings</a>
    </div>
</div>
