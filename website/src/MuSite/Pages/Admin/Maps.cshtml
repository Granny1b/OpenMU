@page "/admin/maps"
@model MuSite.Pages.Admin.MapsModel
@{
    ViewData["Title"] = "Maps";
}

<h1>Maps</h1>
<p class="mu-muted" style="margin-top:-8px">
    Map numbers for <code>/move</code>, and what the configuration spawns on each one.
</p>

<div class="mu-panel">
    <div class="mu-panel__body">
        @if (Model.Maps.Count == 0)
        {
            <div class="mu-empty">
                <div class="mu-empty__title">No maps</div>
                The game configuration may not be installed yet.
            </div>
        }
        else
        {
            <div class="mu-tablewrap">
                <table class="mu-table">
                    <thead>
                        <tr>
                            <th class="mu-table__num">No.</th>
                            <th>Map</th>
                            <th class="mu-table__num">Exp rate</th>
                            <th class="mu-table__num">Spawn areas</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var map in Model.Maps)
                    {
                        <tr>
                            <td class="mu-table__num">@map.Number</td>
                            <td>@map.Name</td>
                            <td class="mu-table__num">@map.ExpMultiplier.ToString("0.##")&times;</td>
                            <td class="mu-table__num">@map.SpawnAreas</td>
                            <td>
                                @if (map.SpawnAreas > 0)
                                {
                                    <a class="mu-btn" href="/admin/maps?number=@map.Number">What spawns here</a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.Selected is { } selected)
{
    <div class="mu-panel">
        <div class="mu-panel__head">
            <h2 class="mu-panel__title">@selected.Name</h2>
        </div>
        <div class="mu-panel__body">
            <div class="mu-field">
                <label class="mu-label" for="move-command">Move a player here &mdash; replace the name</label>
                <input class="mu-input" id="move-command" type="text" value="@Model.MoveExample" readonly />
            </div>
            <p class="mu-hint">
                The map is required even when the player is already on it: OpenMU only treats
                <code>/move</code> as a game master warping someone else when a map is given.
                Append <code>x=</code> and <code>y=</code> for a specific spot.
            </p>

            <h3 class="mu-label" style="margin-top:16px">Monsters on this map</h3>
            <div class="mu-tablewrap">
                <table class="mu-table">
                    <thead>
                        <tr>
                            <th class="mu-table__num">No.</th>
                            <th>Name</th>
                            <th class="mu-table__num">Level</th>
                            <th class="mu-table__num">HP</th>
                            <th class="mu-table__num">Areas here</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var monster in Model.Monsters)
                    {
                        <tr>
                            <td class="mu-table__num">@monster.Number</td>
                            <td><a href="/admin/monsters?q=@Uri.EscapeDataString(monster.Designation)&amp;number=@monster.Number">@monster.Designation</a></td>
                            <td class="mu-table__num">@(monster.Level > 0 ? monster.Level.ToString() : "—")</td>
                            <td class="mu-table__num">@(monster.Health > 0 ? monster.Health.ToString("N0") : "—")</td>
                            <td class="mu-table__num">@monster.SpawnAreas</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
