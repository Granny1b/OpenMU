@page "/admin/accounts"
@model MuSite.Pages.Admin.AccountsModel
@using MuSite.Game
@{
    ViewData["Title"] = "Accounts";
}

<h1>Accounts</h1>

<div class="mu-panel">
    <div class="mu-panel__body">
        <form method="get" class="mu-field" style="max-width:320px">
            <label class="mu-label" for="q">Login name or character name</label>
            <input class="mu-input" id="q" name="q" type="search" value="@Model.Query" placeholder="prefix match" autofocus />
        </form>

        @if (string.IsNullOrWhiteSpace(Model.Query))
        {
            <div class="mu-empty">
                <div class="mu-empty__title">Nothing searched yet</div>
                Search by account login name, or by the name of any character on it.
            </div>
        }
        else if (Model.Results.Count == 0)
        {
            <div class="mu-empty">
                <div class="mu-empty__title">No match</div>
                Nothing starts with &ldquo;@Model.Query&rdquo;.
            </div>
        }
        else
        {
            <div class="mu-tablewrap">
                <table class="mu-table">
                    <thead><tr><th>Account</th><th>State</th><th class="mu-table__num">Characters</th><th>Registered</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Results)
                    {
                        <tr>
                            <td>@row.LoginName</td>
                            <td>
                                @if (GameEnums.AccountState.IsBanned(row.State))
                                {
                                    <span class="mu-badge mu-badge--banned">@GameEnums.AccountState.Describe(row.State)</span>
                                }
                                else if (GameEnums.AccountState.IsGameMaster(row.State))
                                {
                                    <span class="mu-badge mu-badge--gm">@GameEnums.AccountState.Describe(row.State)</span>
                                }
                                else
                                {
                                    @GameEnums.AccountState.Describe(row.State)
                                }
                            </td>
                            <td class="mu-table__num">@row.Characters</td>
                            <td class="mu-muted">@row.Registered.ToString("yyyy-MM-dd")</td>
                            <td><a class="mu-btn mu-btn--sm" href="/admin/accounts/@row.AccountId">Open</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="mu-hint">Every action on an account is keyed to its id, never its name.</p>
        }
    </div>
</div>
