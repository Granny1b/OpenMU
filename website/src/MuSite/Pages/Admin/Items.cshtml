@page "/admin/items"
@model MuSite.Pages.Admin.ItemsModel
@{
    ViewData["Title"] = "Items";
    var query = Model.Query ?? string.Empty;
}

<h1>Items</h1>
<p class="mu-muted" style="margin-top:-8px">
    Search the game's item definitions, then build an <code>/item</code> command. The command drops the
    item on the ground next to you &mdash; stand by the player and they can pick it up.
</p>

@if (Model.Selected is { } selected)
{
    <div class="mu-panel">
        <div class="mu-panel__head">
            <h2 class="mu-panel__title">@selected.Name &mdash; build /item</h2>
        </div>
        <div class="mu-panel__body">
            <form method="get">
                <input type="hidden" name="q" value="@query" />
                <input type="hidden" name="group" value="@selected.Group" />
                <input type="hidden" name="number" value="@selected.Number" />

                <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start">

                    @* ---- item level ------------------------------------------------------- *@
                    <div class="mu-field" style="max-width:130px">
                        <label class="mu-label" for="lvl">Level</label>
                        @if (selected.MaximumItemLevel > 0)
                        {
                            <select class="mu-input" id="lvl" name="lvl">
                                @for (var value = 0; value <= selected.MaximumItemLevel; value++)
                                {
                                    <option value="@value" selected="@((Model.Request?.Level ?? 0) == value)">
                                        @(value == 0 ? "+0 (plain)" : "+" + value)
                                    </option>
                                }
                            </select>
                        }
                        else
                        {
                            <input name="lvl" type="hidden" value="0" />
                            <p class="mu-hint" style="margin:0">Cannot be upgraded.</p>
                        }
                    </div>

                    @* ---- skill and luck --------------------------------------------------- *@
                    <div class="mu-field">
                        <span class="mu-label">Extras</span>
                        <label style="display:block">
                            <input id="sk" name="sk" type="checkbox" value="true" checked="@(Model.Request?.Skill ?? false)" />
                            Skill
                            @if (selected.SkillNumber is null)
                            {
                                <span class="mu-muted">&mdash; this item has no skill, so this does nothing</span>
                            }
                            else if (Model.ExcellentOptions.Count > 0)
                            {
                                <span class="mu-muted">&mdash; any excellent option grants it anyway</span>
                            }
                        </label>
                        <label style="display:block">
                            <input id="lu" name="lu" type="checkbox" value="true" checked="@(Model.Request?.Luck ?? false)" />
                            Luck <span class="mu-muted">&mdash; +5% critical damage chance</span>
                        </label>
                    </div>
                </div>

                @* ---- excellent options -------------------------------------------------------
                   `ex` is a bit field, not a number to pick: the command keeps the options whose
                   bit is set. Ticking them and letting the page add up the bits is the whole point.
                *@
                <div class="mu-field">
                    <span class="mu-label">Excellent options</span>
                    @if (Model.ExcellentOptions.Count == 0)
                    {
                        <p class="mu-hint" style="margin:0">
                            @selected.Name has no excellent options configured &mdash; excellent applies to
                            weapons, armour and shields.
                        </p>
                    }
                    else
                    {
                        <p class="mu-hint" style="margin:0 0 6px">
                            Tick any of the six. Each is worth a value that is added together into
                            <code>ex=</code>; that number is why the same <code>ex</code> means a different
                            bonus on a weapon than on a shield.
                        </p>
                        <div>
                            @foreach (var option in Model.ExcellentOptions)
                            {
                                var ticked = ((Model.Request?.ExcellentNumber ?? 0) & option.BitValue) != 0;
                                <label style="display:block">
                                    <input name="exbit" type="checkbox" value="@option.BitValue" checked="@ticked" />
                                    @OptionText.Describe(option)
                                    <span class="mu-muted">&mdash; option @option.Number, worth @option.BitValue</span>
                                </label>
                            }
                        </div>
                    }
                </div>

                @* ---- ordinary option ---------------------------------------------------------
                   Everywhere but the Dinorant this is a LEVEL, and the levels are configured
                   values (+4 / +8 / +12 / +16), not a scale someone has to remember.
                *@
                <div class="mu-field">
                    <span class="mu-label">Option</span>
                    @if (Model.OptIsBitField)
                    {
                        <p class="mu-hint" style="margin:0 0 6px">
                            The Dinorant is the one item whose <code>opt</code> is a set of switches rather
                            than a level. Tick what it should have.
                        </p>
                        <div>
                            @foreach (var (bit, option) in Model.DinorantOptions)
                            {
                                var ticked = ((Model.Request?.Opt ?? 0) & bit) != 0;
                                <label style="display:block">
                                    <input name="optbit" type="checkbox" value="@bit" checked="@ticked" />
                                    @OptionText.Describe(option)
                                    <span class="mu-muted">&mdash; worth @bit</span>
                                </label>
                            }
                        </div>
                    }
                    else if (Model.OptionLevels.Count == 0)
                    {
                        <input name="opt" type="hidden" value="0" />
                        <p class="mu-hint" style="margin:0">
                            @selected.Name has no ordinary option configured, so there is nothing to add.
                        </p>
                    }
                    else
                    {
                        <select class="mu-input" style="max-width:420px" id="opt" name="opt">
                            <option value="0" selected="@((Model.Request?.Opt ?? 0) == 0)">None</option>
                            @foreach (var level in Model.OptionLevels)
                            {
                                <option value="@level.Level" selected="@((Model.Request?.Opt ?? 0) == level.Level)">
                                    @OptionText.Describe(level) (level @level.Level)
                                </option>
                            }
                        </select>
                        <div>
                            @if (Model.OptionIsAmbiguous)
                            {
                                <p class="mu-hint" style="margin:6px 0 0">
                                    This item has more than one ordinary option and the command applies
                                    whichever the server lists first, so the one you get may not be the one
                                    you picked.
                                </p>
                            }
                        </div>
                    }
                </div>

                @* ---- ancient set -------------------------------------------------------------
                   `anc` is an AncientSetDiscriminator. 1 and 2 name two different real sets and
                   which is which depends on the item, so the numbers alone say nothing.
                *@
                <div class="mu-field">
                    <span class="mu-label">Ancient set</span>
                    @if (Model.AncientSets.Count == 0)
                    {
                        <input name="anc" type="hidden" value="0" />
                        <p class="mu-hint" style="margin:0">
                            @selected.Name is not part of an ancient set.
                        </p>
                    }
                    else
                    {
                        var chosenAncient = Model.Request?.Ancient ?? 0;
                        var chosenLevel = Model.Request?.AncientBonusLevel ?? 1;
                        var chosenSet = Model.AncientSets.FirstOrDefault(s => s.Discriminator == chosenAncient)
                                        ?? Model.AncientSets[0];
                        var bonusName = chosenSet.BonusAttribute ?? "the set's bonus stat";
                        var bonusAtOne = chosenSet.BonusAtLevel1 is { } one
                            ? "+" + OptionText.Number(one) + " " + bonusName
                            : bonusName;
                        var bonusAtTwo = chosenSet.BonusAtLevel2 is { } two
                            ? "+" + OptionText.Number(two) + " " + bonusName
                            : bonusName;

                        <select class="mu-input" style="max-width:420px" id="anc" name="anc">
                            <option value="0" selected="@(chosenAncient == 0)">Not ancient</option>
                            @foreach (var set in Model.AncientSets)
                            {
                                <option value="@set.Discriminator" selected="@(chosenAncient == set.Discriminator)">
                                    @set.SetName (anc=@set.Discriminator)
                                </option>
                            }
                        </select>

                        <div style="margin-top:10px">
                            <span class="mu-label">Ancient bonus</span>
                            <select class="mu-input" style="max-width:420px" id="ancLvl" name="ancLvl">
                                <option value="1" selected="@(chosenLevel == 1)">Level 1 &mdash; @bonusAtOne</option>
                                <option value="2" selected="@(chosenLevel == 2)">Level 2 &mdash; @bonusAtTwo</option>
                            </select>
                            <p class="mu-hint" style="margin:6px 0 0">
                                The bonus is on the item itself. The set's own options need
                                @chosenSet.MinimumItemCount of its @chosenSet.ItemsInSet pieces worn together.
                            </p>
                        </div>
                    }
                </div>

                <button class="mu-btn" type="submit">Build command</button>
            </form>

            @if (Model.Problems.Count > 0)
            {
                <div class="mu-notice mu-notice--warn">
                    <strong>No command built.</strong>
                    <ul style="margin:8px 0 0">
                        @foreach (var problem in Model.Problems)
                        {
                            <li>@problem</li>
                        }
                    </ul>
                </div>
            }
            else if (Model.Command is { } command)
            {
                <div class="mu-field" style="margin-top:16px">
                    <label class="mu-label" for="item-command">Run this in game</label>
                    <input class="mu-input" id="item-command" type="text" value="@command" readonly />
                </div>
                <p class="mu-hint">
                    Only the options you changed are included &mdash; the server defaults the rest, and a
                    shorter command is easier to retype.
                </p>
            }

            @if (Model.CommandDisabledByDefault)
            {
                <div class="mu-notice mu-notice--warn">
                    <code>/item</code> is disabled by default. Enable it on the admin panel's Plugins page.
                </div>
            }
        </div>
    </div>
}

<div class="mu-panel">
    <div class="mu-panel__head">
        <h2 class="mu-panel__title">@(Model.Selected is null ? "Find an item" : "Pick a different item")</h2>
    </div>
    <div class="mu-panel__body">
        <form method="get" style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end">
            <div class="mu-field" style="max-width:280px;margin-bottom:0">
                <label class="mu-label" for="q">Item name</label>
                <input class="mu-input" id="q" name="q" type="search" value="@Model.Query"
                       placeholder="e.g. jewel of bless" autofocus="@(Model.Selected is null)" />
            </div>
            <div class="mu-field" style="max-width:140px;margin-bottom:0">
                <label class="mu-label" for="group">Group</label>
                <input class="mu-input" id="group" name="group" type="number" min="0" max="15"
                       value="@(Model.Group?.ToString() ?? string.Empty)" placeholder="any" />
            </div>
            <button class="mu-btn" type="submit">Search</button>
        </form>

        <p class="mu-hint">Jewels are group @MuSite.Game.GmCommands.JewelGroup in Season 6.</p>

        @if (Model.Results.Count == 0)
        {
            <div class="mu-empty">
                <div class="mu-empty__title">No match</div>
                Nothing matches that name and group.
            </div>
        }
        else
        {
            <div class="mu-tablewrap">
                <table class="mu-table">
                    <thead>
                        <tr>
                            <th class="mu-table__num">Group</th>
                            <th class="mu-table__num">No.</th>
                            <th>Name</th>
                            <th class="mu-table__num">Max +</th>
                            <th class="mu-table__num">Sockets</th>
                            <th class="mu-table__num">Drop lvl</th>
                            <th>Notes</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Results)
                    {
                        <tr>
                            <td class="mu-table__num">@item.Group</td>
                            <td class="mu-table__num">@item.Number</td>
                            <td>@item.Name</td>
                            <td class="mu-table__num">@(item.MaximumItemLevel > 0 ? $"+{item.MaximumItemLevel}" : "—")</td>
                            <td class="mu-table__num">@(item.MaximumSockets > 0 ? item.MaximumSockets.ToString() : "—")</td>
                            <td class="mu-table__num">@item.DropLevel</td>
                            <td>
                                @if (item.IsQuestItem)
                                {
                                    <span class="mu-badge">quest</span>
                                }
                                @if (!item.DropsFromMonsters)
                                {
                                    <span class="mu-badge">no drop</span>
                                }
                            </td>
                            <td>
                                <a class="mu-btn" href="/admin/items?q=@Uri.EscapeDataString(query)&amp;group=@item.Group&amp;number=@item.Number">Build</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
